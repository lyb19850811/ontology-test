<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/medical.owl"
         xmlns="http://example.org/medical.owl#">

<owl:Ontology rdf:about="http://example.org/medical.owl"/>

<owl:ObjectProperty rdf:about="#hasSymptom">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#Symptom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#treats">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="#Disease"/>
  <owl:inverseOf rdf:resource="#treatedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#treatedBy">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#Drug"/>
  <owl:inverseOf rdf:resource="#treats"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Disease">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#InfectiousDisease">
  <rdfs:subClassOf rdf:resource="#Disease"/>
</owl:Class>

<owl:Class rdf:about="#BacterialDisease">
  <rdfs:subClassOf rdf:resource="#InfectiousDisease"/>
  <owl:disjointWith rdf:resource="#ViralDisease"/>
</owl:Class>

<owl:Class rdf:about="#ViralDisease">
  <rdfs:subClassOf rdf:resource="#InfectiousDisease"/>
</owl:Class>

<owl:Class rdf:about="#Drug">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Antibiotic">
  <rdfs:subClassOf rdf:resource="#Drug"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Drug"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#treats"/>
          <owl:someValuesFrom rdf:resource="#BacterialDisease"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#treats"/>
      <owl:allValuesFrom rdf:resource="#BacterialDisease"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Symptom">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#pneumonia">
  <rdf:type rdf:resource="#BacterialDisease"/>
  <hasSymptom rdf:resource="#fever"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">肺炎</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#flu">
  <rdf:type rdf:resource="#ViralDisease"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">流感</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#fever">
  <rdf:type rdf:resource="#Symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">发热</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#amoxicillin">
  <rdf:type rdf:resource="#Drug"/>
  <treats rdf:resource="#pneumonia"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">阿莫西林</rdfs:label>
</owl:NamedIndividual>


</rdf:RDF>
